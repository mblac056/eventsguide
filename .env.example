# Copy this file to ".env" for `npx netlify dev`.
# These values are server-only — never prefix them with VITE_.
# Without them, `npm run dev` still runs on bundled sample data.

# Service account email from the JSON key file.
GOOGLE_CLIENT_EMAIL=

# Private key from the JSON key file. Keep the \n sequences.
GOOGLE_PRIVATE_KEY=

# Folder id from the Drive URL:
#   https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=1z7CqMluiINYRzauY0zOg9VpMeBZQKPlY
