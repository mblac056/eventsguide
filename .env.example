# Copy this file to ".env.local" and fill in your values.
# Without these, Events Guide runs on bundled sample data.

# The spreadsheet id, taken from the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
VITE_SHEET_ID=

# A Google API key with the "Google Sheets API" enabled.
# The spreadsheet must be shared as "Anyone with the link can view".
VITE_GOOGLE_API_KEY=
